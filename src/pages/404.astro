---
import { Icon } from "astro-icon/components";
import PageLayout from "@/layouts/PageLayout.astro";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";

const suggestions = [
  { label: "Services", href: "/services", icon: "lucide:layers", note: "What we build" },
  { label: "Products", href: "/products", icon: "lucide:package", note: "DewLearn School Manager" },
  { label: "Portfolio", href: "/portfolio", icon: "lucide:folder-open", note: "Our recent work" },
  { label: "About", href: "/about", icon: "lucide:users", note: "Who we are" },
  { label: "Blog", href: "/blog", icon: "lucide:newspaper", note: "Articles and tutorials" },
  { label: "Chat with Dewi", href: "/chat", icon: "lucide:bot", note: "Our AI assistant", noCrawl: true },
];
---

<PageLayout
  title="Page not found"
  description="The page you are looking for may have been moved, deleted, or never existed."
  noindex
>
  <Container class="py-16 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-display text-8xl leading-none font-bold tracking-tight sm:text-9xl" aria-label="Error 404">
        4<span class="text-accent">0</span>4
      </p>

      <h1 class="mt-6 text-3xl font-bold text-balance sm:text-4xl">This page doesn’t exist</h1>
      <p class="mx-auto mt-4 max-w-md leading-relaxed text-muted">
        The page you’re looking for may have been moved, deleted, or never existed. Check the address, head back
        home, or tell us what you were looking for.
      </p>

      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <Button href="/" size="lg">
          <Icon name="lucide:house" class="size-4" />
          Go to home
        </Button>
        <Button href="/contact" variant="outline" size="lg">
          <Icon name="lucide:mail" class="size-4" />
          Contact us
        </Button>
      </div>
    </div>

    <div class="mx-auto mt-16 max-w-3xl">
      <h2 class="text-center font-sans text-xs font-semibold tracking-wider text-muted uppercase">Popular pages</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          suggestions.map((s) => (
            <li>
              <a
                href={s.href}
                rel={s.noCrawl ? "nofollow" : undefined}
                data-astro-prefetch={s.noCrawl ? "false" : undefined}
                class="group flex items-center gap-4 rounded-lg border border-border bg-surface p-4 transition-colors hover:border-primary/50 hover:bg-foreground/5"
              >
                <span class="flex size-10 shrink-0 items-center justify-center rounded-md bg-primary/10 text-primary">
                  <Icon name={s.icon} class="size-5" />
                </span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold transition-colors group-hover:text-primary">{s.label}</span>
                  <span class="block truncate text-xs text-muted">{s.note}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</PageLayout>