---
import { cookieCategories } from "@/config/cookies";
import { Icon } from "astro-icon/components";
import Button from "@/components/ui/Button.astro";
---

<dialog
  id="cookie-modal"
  aria-labelledby="cookie-modal-title"
  class="m-0 mt-auto max-h-[88dvh] w-full max-w-full flex-col rounded-t-xl border border-border bg-surface p-0 text-foreground shadow-2xl backdrop:bg-black/50 backdrop:backdrop-blur-sm open:flex open:animate-slide-up sm:m-auto sm:max-w-lg sm:rounded-xl sm:open:animate-zoom-in"
>
  <div class="flex items-start justify-between gap-4 border-b border-border px-5 py-4 sm:px-6">
    <div>
      <h2 id="cookie-modal-title" class="font-sans text-lg font-semibold">Privacy preferences</h2>
      <p class="mt-1 text-sm leading-relaxed text-muted">
        Choose which cookies we may use. You can change this at any time from the footer. See our
        <a href="/privacy-policy" class="text-primary underline underline-offset-2">Privacy Policy</a>.
      </p>
    </div>
    <button
      type="button"
      data-cookie-action="close"
      aria-label="Close"
      class="-mt-1 -mr-2 inline-flex size-9 shrink-0 items-center justify-center rounded-md text-muted transition-colors hover:bg-foreground/5 hover:text-foreground"
    >
      <Icon name="lucide:x" class="size-5" />
    </button>
  </div>

  <div class="flex-1 overflow-y-auto overscroll-contain px-5 sm:px-6">
    <ul class="divide-y divide-border">
      {
        cookieCategories.map((cat) => (
          <li class="flex items-start justify-between gap-4 py-5">
            <div class="min-w-0">
              <h3 id={`cookie-${cat.id}-title`} class="font-sans text-sm font-semibold">
                {cat.title}
                {cat.required && (
                  <span class="ml-2 text-xs font-normal text-muted">Always active</span>
                )}
              </h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{cat.description}</p>
            </div>

            <label class="relative mt-0.5 inline-flex shrink-0 cursor-pointer items-center">
              <input
                type="checkbox"
                role="switch"
                class="peer sr-only"
                aria-labelledby={`cookie-${cat.id}-title`}
                checked={cat.required}
                disabled={cat.required}
                data-category={cat.required ? undefined : cat.id}
              />
              <span class="h-6 w-11 rounded-full bg-foreground/20 transition-colors peer-checked:bg-primary peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary peer-disabled:cursor-not-allowed peer-disabled:opacity-60 after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:shadow-sm after:transition-transform peer-checked:after:translate-x-5" />
            </label>
          </li>
        ))
      }
    </ul>
  </div>

  <div
    class="flex flex-col gap-2 border-t border-border p-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] sm:flex-row sm:justify-end sm:px-6"
  >
    <Button variant="outline" data-cookie-action="reject">Reject non-essential</Button>
    <Button variant="outline" data-cookie-action="accept">Accept all</Button>
    <Button data-cookie-action="save">Save preferences</Button>
  </div>
</dialog>

<script>
  import { getConsent, saveConsent, ACCEPT_ALL, REJECT_ALL, type ConsentCategory } from "@/lib/consent";

  const dialog = document.querySelector<HTMLDialogElement>("#cookie-modal");

  if (dialog) {
    const switches = dialog.querySelectorAll<HTMLInputElement>("input[data-category]");

    const syncSwitches = () => {
      const current = getConsent();
      switches.forEach((input) => {
        input.checked = current?.[input.dataset.category as ConsentCategory] ?? false;
      });
    };

    const open = () => {
      syncSwitches();
      dialog.showModal();
      document.documentElement.classList.add("overflow-hidden");
    };

    dialog.addEventListener("close", () => {
      document.documentElement.classList.remove("overflow-hidden");
    });

    // Anything with data-cookie-settings opens the modal (footer link, banner button)
    document.addEventListener("click", (event) => {
      if ((event.target as Element).closest("[data-cookie-settings]")) open();
    });

    dialog.addEventListener("click", (event) => {
      // A click on the dialog element itself means the dimmed backdrop
      if (event.target === dialog) return dialog.close();

      const action = (event.target as Element).closest<HTMLElement>("[data-cookie-action]")?.dataset.cookieAction;
      if (!action) return;

      if (action === "accept") saveConsent(ACCEPT_ALL);
      if (action === "reject") saveConsent(REJECT_ALL);
      if (action === "save") {
        const choices = { ...REJECT_ALL };
        switches.forEach((input) => {
          choices[input.dataset.category as ConsentCategory] = input.checked;
        });
        saveConsent(choices);
      }
      dialog.close();
    });
  }
</script>