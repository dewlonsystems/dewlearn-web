---
import Button from "@/components/ui/Button.astro";
---

<div
  id="cookie-banner"
  role="dialog"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-desc"
  hidden
  class="fixed inset-x-4 bottom-4 z-50 animate-slide-up rounded-lg border border-border bg-surface p-5 shadow-xl shadow-black/10 sm:right-auto sm:bottom-6 sm:left-6 sm:max-w-sm"
>
  <h2 id="cookie-title" class="font-sans text-base font-semibold">Cookies on this site</h2>
  <p id="cookie-desc" class="mt-2 text-sm leading-relaxed text-muted">
    We use essential cookies to keep the site working, and optional ones to understand how it is used. Read our
    <a href="/privacy-policy" class="text-primary underline underline-offset-2">Privacy Policy</a>.
  </p>
  <div class="mt-4 grid grid-cols-2 gap-2">
    <Button size="sm" data-consent="accept">Accept all</Button>
    <Button size="sm" variant="outline" data-consent="reject">Reject non-essential</Button>
    <Button size="sm" variant="ghost" data-cookie-settings class="col-span-2">Customize</Button>
  </div>
</div>

<script>
  import { getConsent, saveConsent, ACCEPT_ALL, REJECT_ALL, CONSENT_EVENT } from "@/lib/consent";

  const banner = document.getElementById("cookie-banner");

  if (banner) {
    if (!getConsent()) banner.hidden = false;

    // Hides the banner when a choice is saved here or in the modal
    window.addEventListener(CONSENT_EVENT, () => {
      banner.hidden = true;
    });

    banner.addEventListener("click", (event) => {
      const choice = (event.target as Element).closest<HTMLElement>("[data-consent]")?.dataset.consent;
      if (choice === "accept") saveConsent(ACCEPT_ALL);
      if (choice === "reject") saveConsent(REJECT_ALL);
    });
  }
</script>