---
import { Icon } from "astro-icon/components";
import Container from "@/components/ui/Container.astro";
import Logo from "@/components/ui/Logo.astro";
import { siteConfig } from "@/config/site";
import { socialLinks } from "@/config/social";
import { services } from "@/config/offerings";
import { footerNav, legalNav } from "@/config/navigation";

const { contact, address, offices } = siteConfig;
const year = new Date().getFullYear();
const otherOffices = offices.filter((o) => o !== address.city).join(" and ");

const columns = [
  {
    title: "Services",
    class: "col-span-2 sm:col-span-1",
    links: services.map((s) => ({ label: s.name, href: s.path })),
  },
  { title: "Explore", class: "", links: footerNav.explore },
  { title: "Company", class: "", links: footerNav.company },
];

const linkClass = "text-sm text-muted transition-colors hover:text-foreground";
---

<footer class="border-t border-border bg-surface">
  <Container class="py-14 lg:py-16">
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-[1.4fr_1fr_1fr_1fr] lg:gap-x-12">
      <div class="col-span-2 sm:col-span-3 lg:col-span-1">
        <Logo />
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted">
          {siteConfig.tagline} Custom software, web and mobile applications for businesses across East Africa.
        </p>

        <address class="mt-6 space-y-3 text-sm not-italic">
          <a href={`mailto:${contact.email}`} class="flex items-center gap-3 text-muted transition-colors hover:text-foreground">
            <Icon name="lucide:mail" class="size-4 shrink-0 text-primary" />
            {contact.email}
          </a>
          <a href={`tel:${contact.phone}`} class="flex items-center gap-3 text-muted transition-colors hover:text-foreground">
            <Icon name="lucide:phone" class="size-4 shrink-0 text-primary" />
            {contact.phoneDisplay}
          </a>
          <div class="flex items-start gap-3 text-muted">
            <Icon name="lucide:map-pin" class="mt-0.5 size-4 shrink-0 text-primary" />
            <span>
              {address.street}, {address.city}, Kenya
              <span class="block text-xs">Also in {otherOffices}</span>
            </span>
          </div>
        </address>

        <ul class="mt-6 flex flex-wrap gap-2">
          {
            socialLinks.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  class="flex size-9 items-center justify-center rounded-md border border-border text-muted transition-colors hover:border-primary hover:text-primary"
                >
                  <Icon name={s.icon} class="size-4" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        columns.map((col) => (
          <nav aria-label={col.title} class={col.class}>
            <h2 class="font-sans text-xs font-semibold tracking-wider uppercase">{col.title}</h2>
            <ul class="mt-4 space-y-2.5">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class={linkClass}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </Container>

  <div class="border-t border-border">
    <Container class="flex flex-col gap-4 py-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {siteConfig.legalName}. All rights reserved.</p>
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
        {
          legalNav.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-foreground">
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <button
            type="button"
            data-cookie-settings
            class="inline-flex items-center gap-2 transition-colors hover:text-foreground"
          >
            Your privacy choices
            <svg
              viewBox="0 0 30 14"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              class="h-3.5 w-auto"
            >
              <path d="M7 1h16a6 6 0 0 1 0 12H7A6 6 0 0 1 7 1Z" fill="#ffffff" stroke="#0066ff" stroke-width="1.5" />
              <path d="M15 1h8a6 6 0 0 1 0 12h-8Z" fill="#0066ff" />
              <path
                d="M5.6 7.2l1.9 1.9 3.5-3.9"
                stroke="#0066ff"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path d="M19.8 4.8l4.4 4.4M24.2 4.8l-4.4 4.4" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </button>
        </li>
      </ul>
    </Container>
  </div>
</footer>