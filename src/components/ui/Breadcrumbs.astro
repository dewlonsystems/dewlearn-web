---
import { Icon } from "astro-icon/components";
import JsonLd from "@/components/seo/JsonLd.astro";
import { breadcrumbSchema } from "@/lib/schema";
import { cn } from "@/lib/cn";

interface Props {
  /** The trail after Home. The last item is the current page. */
  items: { name: string; path: string }[];
  tone?: "default" | "onDark";
  class?: string;
}

const { items, tone = "default", class: className } = Astro.props;

const trail = [{ name: "Home", path: "/" }, ...items];
const onDark = tone === "onDark";
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class={cn("flex flex-wrap items-center gap-x-2 gap-y-1 text-sm", onDark ? "text-white/70" : "text-muted")}>
    {
      trail.map((item, i) => {
        const last = i === trail.length - 1;
        return (
          <li class="flex items-center gap-2">
            {i > 0 && <Icon name="lucide:chevron-right" class="size-3.5 opacity-60" aria-hidden="true" />}
            {last ? (
              <span aria-current="page" class={cn("font-medium", onDark ? "text-white" : "text-foreground")}>
                {item.name}
              </span>
            ) : (
              <a
                href={item.path}
                class={cn(
                  "underline-offset-4 transition-colors hover:underline",
                  onDark ? "hover:text-white" : "hover:text-foreground",
                )}
              >
                {item.name}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<JsonLd data={breadcrumbSchema(trail)} />