---
import { cn } from "@/lib/cn";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  as?: "h1" | "h2" | "h3";
  class?: string;
}

const { eyebrow, title, description, align = "left", as: Heading = "h2", class: className } = Astro.props;
---

<div class={cn("max-w-2xl", align === "center" && "mx-auto text-center", className)}>
  {eyebrow && <p class="mb-3 text-sm font-semibold tracking-wider text-primary uppercase">{eyebrow}</p>}
  <Heading class="text-3xl font-bold sm:text-4xl">{title}</Heading>
  {description && <p class="mt-4 text-lg leading-relaxed text-muted">{description}</p>}
</div>