---
import { Icon } from "astro-icon/components";
import Button from "@/components/ui/Button.astro";
import { cn } from "@/lib/cn";

interface Props {
  src: string;
  title: string;
  href: string;
  class?: string;
}

const { src, title, href, class: className } = Astro.props;
---

<div
  data-map
  data-src={src}
  data-title={title}
  class={cn("relative aspect-4/3 overflow-hidden rounded-lg border border-border bg-background sm:aspect-video", className)}
>
  <div class="flex h-full flex-col items-center justify-center gap-4 p-6 text-center">
    <span class="flex size-12 items-center justify-center rounded-full bg-primary/10 text-primary">
      <Icon name="lucide:map-pin" class="size-6" />
    </span>
    <div>
      <p class="font-medium">{title}</p>
      <p class="mx-auto mt-1 max-w-xs text-sm text-muted">
        The map loads from Google only when you ask for it, so nothing is shared until then.
      </p>
    </div>
    <div class="flex flex-wrap justify-center gap-2">
      <Button size="sm" data-map-load>Load map</Button>
      <Button size="sm" variant="outline" {href} target="_blank" rel="noopener noreferrer">
        Open in Google Maps
      </Button>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-map]").forEach((box) => {
    box.querySelector("[data-map-load]")?.addEventListener("click", () => {
      const src = box.dataset.src ?? "";
      if (!src.startsWith("https://www.google.com/maps/embed")) return;

      const frame = document.createElement("iframe");
      frame.src = src;
      frame.title = box.dataset.title ?? "Map";
      frame.loading = "lazy";
      frame.referrerPolicy = "no-referrer-when-downgrade";
      frame.allowFullscreen = true;
      frame.className = "absolute inset-0 size-full border-0";
      box.replaceChildren(frame);
    });
  });
</script>