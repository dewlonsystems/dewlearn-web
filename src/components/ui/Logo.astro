---
import { siteConfig } from "@/config/site";
import { cn } from "@/lib/cn";

interface Props {
  class?: string;
  imgClass?: string;
}

const { class: className, imgClass } = Astro.props;
---

<a
  href="/"
  aria-label={`${siteConfig.name} – home`}
  class={cn("inline-flex shrink-0 items-center rounded-md", className)}
>
  <img src={siteConfig.logo.src} alt="" width="40" height="40" class={cn("size-10", imgClass)} />
</a>