---
import { cn } from "@/lib/cn";
import Container from "./Container.astro";

interface Props {
  id?: string;
  tone?: "default" | "muted";
  class?: string;
  containerClass?: string;
}

const { id, tone = "default", class: className, containerClass } = Astro.props;
---

<section
  id={id}
  class={cn(
    "scroll-mt-20 py-16 sm:py-20 lg:py-24",
    tone === "muted" && "border-y border-border bg-surface",
    className,
  )}
>
  <Container class={containerClass}>
    <slot />
  </Container>
</section>