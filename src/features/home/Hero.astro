---
import { Icon } from "astro-icon/components";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import { heroSlides } from "./content";
---

<section
  data-hero
  aria-roledescription="carousel"
  aria-label="Dewlon Systems highlights"
  class="relative isolate flex min-h-136 items-center overflow-hidden bg-brand text-brand-foreground lg:min-h-168"
>
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    {
      heroSlides.map((slide, i) => (
        <video
          data-hero-video
          data-src={slide.video}
          data-active={i === 0 ? "" : undefined}
          muted
          loop
          playsinline
          preload="none"
          tabindex="-1"
          class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-700 data-active:opacity-100"
        />
      ))
    }
    <div class="absolute inset-0 bg-brand/80"></div>
  </div>

  <Container class="w-full pt-32 pb-28 lg:pt-44 lg:pb-32">
    <div data-hero-stage aria-live="off" class="grid">
      {
        heroSlides.map((slide, i) => {
          const Heading = i === 0 ? "h1" : "h2";
          return (
            <div
              data-hero-slide
              data-active={i === 0 ? "" : undefined}
              inert={i !== 0}
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${heroSlides.length}`}
              class="invisible col-start-1 row-start-1 max-w-2xl translate-y-2 opacity-0 transition-[opacity,translate,visibility] duration-500 data-active:visible data-active:translate-y-0 data-active:opacity-100"
            >
              <p class="text-sm font-semibold tracking-wider text-white/70 uppercase">{slide.eyebrow}</p>
              <Heading class="mt-4 font-display text-4xl font-bold text-balance sm:text-5xl lg:text-6xl">
                {slide.title}
              </Heading>
              <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/75">{slide.description}</p>
              <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <Button href={slide.primary.href} variant="accent" size="lg">
                  {slide.primary.label}
                  <Icon name="lucide:arrow-right" class="size-4" />
                </Button>
                <Button
                  href={slide.secondary.href}
                  variant="outline"
                  size="lg"
                  class="border-white/30 bg-transparent text-white hover:bg-white/10"
                >
                  {slide.secondary.label}
                </Button>
              </div>
            </div>
          );
        })
      }
    </div>
  </Container>

  <div class="absolute inset-x-0 bottom-0">
    <Container class="flex items-center gap-4 pb-6 lg:pb-8">
      <div class="flex items-center gap-1.5">
        <button
          type="button"
          data-hero-prev
          aria-label="Previous slide"
          class="inline-flex size-10 items-center justify-center rounded-full border border-white/25 text-white/80 transition-colors hover:bg-white/10 hover:text-white"
        >
          <Icon name="lucide:chevron-left" class="size-5" />
        </button>
        <button
          type="button"
          data-hero-next
          aria-label="Next slide"
          class="inline-flex size-10 items-center justify-center rounded-full border border-white/25 text-white/80 transition-colors hover:bg-white/10 hover:text-white"
        >
          <Icon name="lucide:chevron-right" class="size-5" />
        </button>
      </div>

      <div class="flex items-center" role="group" aria-label="Choose a slide">
        {
          heroSlides.map((_, i) => (
            <button
              type="button"
              data-hero-dot
              data-active={i === 0 ? "" : undefined}
              aria-current={i === 0 ? "true" : undefined}
              aria-label={`Go to slide ${i + 1}`}
              class="group flex h-8 items-center px-1"
            >
              <span class="block h-1.5 w-1.5 rounded-full bg-white/40 transition-all group-hover:bg-white/70 group-data-active:w-6 group-data-active:bg-white" />
            </button>
          ))
        }
      </div>

      <button
        type="button"
        data-hero-toggle
        aria-label="Pause slideshow"
        class="group ml-auto inline-flex size-10 items-center justify-center rounded-full border border-white/25 text-white/80 transition-colors hover:bg-white/10 hover:text-white"
      >
        <Icon name="lucide:pause" class="size-4 group-data-paused:hidden" />
        <Icon name="lucide:play" class="hidden size-4 group-data-paused:block" />
      </button>
    </Container>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]");

  if (hero) {
    const stage = hero.querySelector<HTMLElement>("[data-hero-stage]")!;
    const slides = Array.from(hero.querySelectorAll<HTMLElement>("[data-hero-slide]"));
    const videos = Array.from(hero.querySelectorAll<HTMLVideoElement>("[data-hero-video]"));
    const dots = Array.from(hero.querySelectorAll<HTMLElement>("[data-hero-dot]"));
    const toggle = hero.querySelector<HTMLButtonElement>("[data-hero-toggle]")!;

    const SLIDE_MS = 10_000;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const canHover = window.matchMedia("(hover: hover)");
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    const dataSaver = connection?.saveData === true;

    let index = 0;
    let userPaused = reduceMotion.matches;
    let hovering = false;
    let focusing = false;
    let inView = true;
    let timer: number | undefined;

    const sync = () => {
      window.clearTimeout(timer);
      const live = inView && !document.hidden;
      const video = videos[index];

      // The video downloads only when its slide is actually about to play
      if (video) {
        if (live && !userPaused && !dataSaver && !reduceMotion.matches) {
          if (!video.getAttribute("src")) video.src = video.dataset.src ?? "";
          video.muted = true;
          void video.play().catch(() => {});
        } else {
          video.pause();
        }
      }

      const rotating = live && !userPaused && !hovering && !focusing;
      stage.setAttribute("aria-live", rotating ? "off" : "polite");
      if (rotating) timer = window.setTimeout(() => show(index + 1), SLIDE_MS);
    };

    const show = (to: number) => {
      const previous = index;
      index = (to + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        const active = i === index;
        slide.toggleAttribute("data-active", active);
        slide.inert = !active;
      });
      dots.forEach((dot, i) => {
        dot.toggleAttribute("data-active", i === index);
        if (i === index) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
      videos.forEach((video, i) => video.toggleAttribute("data-active", i === index));

      // Let the old video fade out before stopping it
      window.setTimeout(() => {
        if (previous !== index) videos[previous]?.pause();
      }, 700);

      sync();
    };

    const renderToggle = () => {
      toggle.toggleAttribute("data-paused", userPaused);
      toggle.setAttribute("aria-label", userPaused ? "Play slideshow" : "Pause slideshow");
    };

    toggle.addEventListener("click", () => {
      userPaused = !userPaused;
      renderToggle();
      sync();
    });

    hero.querySelector("[data-hero-prev]")?.addEventListener("click", () => show(index - 1));
    hero.querySelector("[data-hero-next]")?.addEventListener("click", () => show(index + 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => show(i)));

    hero.addEventListener("mouseenter", () => {
      if (!canHover.matches) return;
      hovering = true;
      sync();
    });
    hero.addEventListener("mouseleave", () => {
      hovering = false;
      sync();
    });
    hero.addEventListener("focusin", (event) => {
      if (!(event.target as Element).matches(":focus-visible")) return; // clicks don't count, keyboard does
      focusing = true;
      sync();
    });
    hero.addEventListener("focusout", (event) => {
      if (hero.contains(event.relatedTarget as Node | null)) return;
      focusing = false;
      sync();
    });

    hero.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") show(index + 1);
      else if (event.key === "ArrowLeft") show(index - 1);
    });

    let startX = 0;
    let startY = 0;
    hero.addEventListener(
      "touchstart",
      (event) => {
        startX = event.touches[0].clientX;
        startY = event.touches[0].clientY;
      },
      { passive: true },
    );
    hero.addEventListener(
      "touchend",
      (event) => {
        const dx = event.changedTouches[0].clientX - startX;
        const dy = Math.abs(event.changedTouches[0].clientY - startY);
        if (Math.abs(dx) > 50 && Math.abs(dx) > dy * 1.5) show(index + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );

    // Stop work when nobody is looking
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      sync();
    }).observe(hero);
    document.addEventListener("visibilitychange", sync);
    reduceMotion.addEventListener("change", () => {
      userPaused = reduceMotion.matches;
      renderToggle();
      sync();
    });

    renderToggle();
    sync();
  }
</script>