---
import Container from "@/components/ui/Container.astro";
import { stats } from "./content";
---

<section class="bg-brand text-brand-foreground">
  <Container class="py-14">
    <dl class="grid grid-cols-2 gap-y-10 lg:grid-cols-4 lg:divide-x lg:divide-white/15">
      {
        stats.map((stat) => (
          <div class="flex flex-col-reverse items-center gap-1.5 px-4 text-center">
            <dt class="text-xs font-medium tracking-wider text-white/70 uppercase">{stat.label}</dt>
            <dd class="font-display text-4xl font-bold sm:text-5xl">
              <span data-count={stat.value}>{stat.value}</span>{stat.suffix}
            </dd>
          </div>
        ))
      }
    </dl>
  </Container>
</section>

<script>
  const counters = document.querySelectorAll<HTMLElement>("[data-count]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Without JavaScript, or with reduced motion, the real numbers simply stay put
  if (counters.length && !reduceMotion && "IntersectionObserver" in window) {
    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      const duration = 1600;
      const start = performance.now();

      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        el.textContent = String(Math.round((1 - (1 - progress) ** 3) * target));
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          run(entry.target as HTMLElement);
          obs.unobserve(entry.target);
        });
      },
      { threshold: 0.4 },
    );

    counters.forEach((el) => {
      el.textContent = "0";
      observer.observe(el);
    });
  }
</script>