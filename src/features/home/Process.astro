---
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { processSteps } from "./content";
---

<Section id="process" tone="muted">
  <SectionHeading
    eyebrow="How we work"
    title="A process built for no surprises"
    description="Every project follows the same four stages, so you have visibility and control from day one to go-live."
  />

  <ol class="mt-12 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
    {
      processSteps.map((step, i) => (
        <li class="border-t-2 border-primary pt-5">
          <span class="font-display text-sm font-bold text-primary">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="mt-3 font-sans text-lg font-semibold">{step.title}</h3>
          <p class="mt-1 text-sm font-medium text-muted">{step.subtitle}</p>
          <p class="mt-4 text-sm leading-relaxed text-muted">{step.text}</p>
        </li>
      ))
    }
  </ol>
</Section>