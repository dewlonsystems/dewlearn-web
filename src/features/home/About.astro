---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Section from "@/components/ui/Section.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
import { aboutImage, aboutPoints } from "./content";
---

<Section id="about">
  <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
    <div class="relative order-2 lg:order-1">
      <Image
        src={aboutImage}
        alt="The Dewlon Systems team working in their Nairobi office"
        widths={[480, 768, 1100]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        class="aspect-4/3 w-full rounded-lg object-cover"
      />
      <p class="absolute bottom-4 left-4 rounded-md bg-brand px-4 py-2 text-sm text-brand-foreground">
        <span class="font-display font-bold">Since {siteConfig.foundingYear}</span> · Nairobi
      </p>
    </div>

    <div class="order-1 lg:order-2">
      <p class="text-sm font-semibold tracking-wider text-primary uppercase">Who we are</p>
      <h2 class="mt-3 text-3xl font-bold text-balance sm:text-4xl">Proudly Kenyan. Globally capable.</h2>
      <p class="mt-6 leading-relaxed text-muted">
        Dewlon Systems is a software engineering firm headquartered in Imara Daima, Nairobi. Since {siteConfig.foundingYear},
        we have helped businesses, institutions and government bodies across Kenya build the digital products that run
        their operations.
      </p>
      <p class="mt-4 leading-relaxed text-muted">
        We pair global engineering standards, including clean architecture, automated testing, CI/CD and cloud-native
        infrastructure, with a practical understanding of East African business, user behaviour, connectivity and
        regulation. We don’t disappear after launch.
      </p>

      <ul class="mt-6 space-y-3">
        {
          aboutPoints.map((point) => (
            <li class="flex items-start gap-3 text-sm font-medium">
              <Icon name="lucide:check" class="mt-0.5 size-5 shrink-0 text-primary" />
              {point}
            </li>
          ))
        }
      </ul>

      <Button href="/about" variant="outline" class="mt-8">
        More about us
        <Icon name="lucide:arrow-right" class="size-4" />
      </Button>
    </div>
  </div>
</Section>